# macOS
.DS_Store
# the built game: it goes to the GitHub release, not into the repository
*.app/
# Unity: generated or per-machine
RoadToCanaan/Library/
RoadToCanaan/Temp/
RoadToCanaan/Logs/
RoadToCanaan/Builds/
RoadToCanaan/obj/
RoadToCanaan/UserSettings/
RoadToCanaan/*.csproj
RoadToCanaan/*.sln
