*.blend1
# built by Tools/setup.sh from the textures and the models (loaded by name, nothing refers to them)
RoadToCanaan/Assets/Canaan/Resources/Models.asset
RoadToCanaan/Assets/Canaan/Resources/Models.asset.meta
RoadToCanaan/Assets/Canaan/Resources/Surf/SurfColor.asset
RoadToCanaan/Assets/Canaan/Resources/Surf/SurfColor.asset.meta
RoadToCanaan/Assets/Canaan/Resources/Surf/SurfDetail.asset
RoadToCanaan/Assets/Canaan/Resources/Surf/SurfDetail.asset.meta
